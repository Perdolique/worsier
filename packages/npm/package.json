{
  "name": "worsier",
  "version": "1.0.6",
  "description": "A focused JavaScript and TypeScript import and variable-boundary formatter powered by Rust",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Perdolique/worsier.git",
    "directory": "packages/npm"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./configuration_schema.json": "./configuration_schema.json"
  },
  "bin": {
    "worsier": "bin/worsier.js"
  },
  "files": [
    "bin",
    "dist",
    "configuration_schema.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:native": "node scripts/build-native.mjs",
    "test": "node --test test/*.test.mjs",
    "test:packed": "node scripts/test-packed-package.mjs"
  },
  "napi": {
    "binaryName": "worsier",
    "targets": [
      "aarch64-apple-darwin",
      "aarch64-pc-windows-msvc",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ]
  },
  "optionalDependencies": {
    "worsier-darwin-arm64": "workspace:*",
    "worsier-darwin-x64": "workspace:*",
    "worsier-linux-arm64-gnu": "workspace:*",
    "worsier-linux-arm64-musl": "workspace:*",
    "worsier-linux-x64-gnu": "workspace:*",
    "worsier-linux-x64-musl": "workspace:*",
    "worsier-win32-arm64-msvc": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FormatConfig",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "ignorePatterns": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "lineWidth": {
      "type": "integer",
      "format": "uint32",
      "default": 120,
      "minimum": 1
    },
    "rules": {
      "$ref": "#/$defs/RulesConfig",
      "default": {
        "importLayout": true,
        "interfaceLayout": 0,
        "objectPropertySpacing": true,
        "semicolons": {
          "classMembers": "asNeeded",
          "statements": "asNeeded",
          "typeMembers": "asNeeded"
        },
        "statementSpacing": {
          "controlFlowStatements": "separate",
          "imports": "separate",
          "returnStatements": "separate",
          "typeAliases": "separate",
          "variableDeclarations": "separate"
        },
        "trailingCommas": "never"
      }
    },
    "verifyAst": {
      "type": "boolean",
      "default": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "InterfaceLayoutMode": {
      "type": "string",
      "enum": [
        "off"
      ]
    },
    "InterfaceLayoutRule": {
      "anyOf": [
        {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0
        },
        {
          "$ref": "#/$defs/InterfaceLayoutMode"
        }
      ]
    },
    "RulesConfig": {
      "type": "object",
      "properties": {
        "importLayout": {
          "type": "boolean",
          "default": true
        },
        "interfaceLayout": {
          "$ref": "#/$defs/InterfaceLayoutRule",
          "default": 0
        },
        "objectPropertySpacing": {
          "type": "boolean",
          "default": true
        },
        "semicolons": {
          "$ref": "#/$defs/SemicolonConfig",
          "default": {
            "classMembers": "asNeeded",
            "statements": "asNeeded",
            "typeMembers": "asNeeded"
          }
        },
        "statementSpacing": {
          "$ref": "#/$defs/StatementSpacingConfig",
          "default": {
            "controlFlowStatements": "separate",
            "imports": "separate",
            "returnStatements": "separate",
            "typeAliases": "separate",
            "variableDeclarations": "separate"
          }
        },
        "trailingCommas": {
          "$ref": "#/$defs/TrailingCommaMode",
          "default": "never"
        }
      },
      "additionalProperties": false
    },
    "SemicolonConfig": {
      "type": "object",
      "properties": {
        "classMembers": {
          "$ref": "#/$defs/SemicolonMode",
          "default": "asNeeded"
        },
        "statements": {
          "$ref": "#/$defs/SemicolonMode",
          "default": "asNeeded"
        },
        "typeMembers": {
          "$ref": "#/$defs/SemicolonMode",
          "default": "asNeeded"
        }
      },
      "additionalProperties": false
    },
    "SemicolonMode": {
      "type": "string",
      "enum": [
        "always",
        "asNeeded",
        "off"
      ]
    },
    "StatementSpacingConfig": {
      "type": "object",
      "properties": {
        "controlFlowStatements": {
          "$ref": "#/$defs/StatementSpacingMode",
          "default": "separate"
        },
        "imports": {
          "$ref": "#/$defs/StatementSpacingMode",
          "default": "separate"
        },
        "returnStatements": {
          "$ref": "#/$defs/StatementSpacingMode",
          "default": "separate"
        },
        "typeAliases": {
          "$ref": "#/$defs/StatementSpacingMode",
          "default": "separate"
        },
        "variableDeclarations": {
          "$ref": "#/$defs/StatementSpacingMode",
          "default": "separate"
        }
      },
      "additionalProperties": false
    },
    "StatementSpacingMode": {
      "type": "string",
      "enum": [
        "separate",
        "compact",
        "off"
      ]
    },
    "TrailingCommaMode": {
      "type": "string",
      "enum": [
        "always",
        "never",
        "off"
      ]
    }
  }
}

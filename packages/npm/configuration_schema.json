{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FormatConfig",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "ignorePatterns": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "lineWidth": {
      "type": "integer",
      "format": "uint32",
      "default": 120,
      "minimum": 1
    },
    "rules": {
      "$ref": "#/$defs/RulesConfig",
      "default": {
        "importLayout": true,
        "statementSpacing": {
          "imports": "separate",
          "variableDeclarations": "separate"
        },
        "trailingCommas": "never"
      }
    },
    "verifyAst": {
      "type": "boolean",
      "default": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "RulesConfig": {
      "type": "object",
      "properties": {
        "importLayout": {
          "type": "boolean",
          "default": true
        },
        "statementSpacing": {
          "$ref": "#/$defs/StatementSpacingConfig",
          "default": {
            "imports": "separate",
            "variableDeclarations": "separate"
          }
        },
        "trailingCommas": {
          "$ref": "#/$defs/TrailingCommaMode",
          "default": "never"
        }
      },
      "additionalProperties": false
    },
    "StatementSpacingConfig": {
      "type": "object",
      "properties": {
        "imports": {
          "$ref": "#/$defs/StatementSpacingMode",
          "default": "separate"
        },
        "variableDeclarations": {
          "$ref": "#/$defs/StatementSpacingMode",
          "default": "separate"
        }
      },
      "additionalProperties": false
    },
    "StatementSpacingMode": {
      "type": "string",
      "enum": [
        "separate",
        "compact",
        "off"
      ]
    },
    "TrailingCommaMode": {
      "type": "string",
      "enum": [
        "always",
        "never",
        "off"
      ]
    }
  }
}

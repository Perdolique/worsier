{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FormatConfig",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "ignorePatterns": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "lineWidth": {
      "type": "integer",
      "format": "uint32",
      "default": 120,
      "minimum": 1
    },
    "rules": {
      "$ref": "#/$defs/RulesConfig",
      "default": {
        "imports": true,
        "variables": true
      }
    },
    "verifyAst": {
      "type": "boolean",
      "default": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "RulesConfig": {
      "type": "object",
      "properties": {
        "imports": {
          "type": "boolean",
          "default": true
        },
        "variables": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    }
  }
}
